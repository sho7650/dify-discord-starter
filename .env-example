DIFY_API_KEY="app..." # Dify api secret key
DIFY_API_BASE_URL="https://api.dify.ai/v1" # Dify instance base url
DISCORD_BOT_TOKEN="" # Discord bot token from https://discord.com/developers/applications
HISTORY_MODE="user" # Use "user" or "channel"
MAX_MESSAGE_LENGTH="2000" # Set it to the max message length (chars) allowed for your bot to send. Defaults to 2000. The bot will split messages and send multiple ones if a message is longer than this number.
MESSAGE_CONTENT_ALLOWED="false" # Set to true to enable message content intent. Remember to enable this intent in the discord developer portal.
TRIGGER_KEYWORDS=[] # JSON array of strings the bot listens to. Example: ["dify"]. Any other value disables keywords with a warning. Set to [""] to listen to all messages. Requires MESSAGE_CONTENT_ALLOWED to be set to true.
RATE_LIMIT_MAX="10" # Max Dify calls per user within RATE_LIMIT_WINDOW_SEC, counted across servers. Set to 0 to disable.
RATE_LIMIT_WINDOW_SEC="60" # Length of the rate limit window in seconds.
DIFY_IDLE_TIMEOUT_SEC="120" # Abort a Dify request when nothing (not even a ping) arrives for this many seconds.
